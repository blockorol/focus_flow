#!/bin/sh
set -eu

command="${1:-}"
case "$command" in
  up|status|down)
    ;;
  *)
    echo "Usage: migrate up|status|down" >&2
    exit 2
    ;;
esac

migration_dir="${GOOSE_MIGRATION_DIR:-/app/migrations}"
if [ ! -d "$migration_dir" ]; then
  echo "Migration directory does not exist: $migration_dir" >&2
  exit 1
fi

if ! find "$migration_dir" -maxdepth 1 -type f -name '*.sql' -print -quit | grep -q .; then
  echo "No SQL migrations found in $migration_dir."
  exit 0
fi

if [ -z "${DATABASE_URL:-}" ]; then
  echo "DATABASE_URL is required to run migrations." >&2
  exit 1
fi

export GOOSE_DRIVER=postgres
export GOOSE_DBSTRING="$DATABASE_URL"

exec "${GOOSE_BIN:-/app/bin/goose}" -dir "$migration_dir" "$command"
