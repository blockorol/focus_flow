# Docker Compose provides development DATABASE_URL, APP_ENV, PORT, and CORS defaults.
# Optional override for a database outside the Compose project:
# DATABASE_URL=postgres://user:password@host:5432/database

# Reserved for Phase 1 authentication. Not used by the Phase 0 server.
APP_USERNAME=local
# Single quotes preserve literal dollar signs in an encoded hash.
APP_PASSWORD_HASH='replace-with-the-stdin-helper-output'
APP_TOKEN_SECRET=replace-with-a-random-local-secret-before-phase-1
