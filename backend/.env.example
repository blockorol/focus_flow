# Docker Compose provides development DATABASE_URL, APP_ENV, PORT, and CORS defaults.
# Optional override for a database outside the Compose project:
# DATABASE_URL=postgres://user:password@host:5432/database

# Reserved for BE full MVP authentication. Not used by the Phase 0 server.
APP_USERNAME=local
APP_PASSWORD=replace-with-a-local-password-before-auth-implementation
APP_TOKEN_SECRET=replace-with-a-random-local-secret-before-auth-implementation
