# Docker Compose provides development DATABASE_URL, APP_ENV, PORT, and CORS defaults.
# Optional override for a database outside the Compose project:
# DATABASE_URL=postgres://user:password@host:5432/database

# Single-user authentication. Use different values outside local development.
APP_USER_ID=018f6f1f-9a7b-7000-8000-000000000001
APP_USERNAME=local
APP_PASSWORD=replace-with-a-local-password
APP_TOKEN_SECRET=replace-with-at-least-32-random-characters
